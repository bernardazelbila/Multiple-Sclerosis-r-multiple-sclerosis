#!/usr/bin/env python3
"""
spaCy preprocessing for: r_MultipleSclerosis_corpus
Location: /Users/user/Desktop/Other Docs/Multiple Sclerosis/Data

Outputs:
- preprocessed/r_MultipleSclerosis_corpus.preprocessed.txt
- (optional) preprocessed/r_MultipleSclerosis_corpus.tokens.csv
"""

from __future__ import annotations

import re
import sys
from pathlib import Path
from typing import Iterable, List, Tuple

import spacy


# ---------------------------
# Config
# ---------------------------
BASE_DIR = Path("/Users/user/Desktop/Other Docs/Multiple Sclerosis/Data")
BASENAME = "r_MultipleSclerosis_corpus"  # do not include extension unless you want to
OUT_DIR = BASE_DIR / "preprocessed"

# Choose model: "en_core_web_sm" (fast) or "en_core_web_trf" (best, heavier)
SPACY_MODEL = "en_core_web_sm"

# Preprocessing switches
USE_LEMMA = True              # if False, uses token.text
LOWERCASE = True
REMOVE_STOPWORDS = True
REMOVE_PUNCT = True
REMOVE_NUMS = True
KEEP_NEGATIONS = True         # keep "no", "not", "n't" even if stopword removal is on
MIN_TOKEN_LEN = 2             # drop 1-char tokens (set to 1 if you want to keep)
BATCH_SIZE = 1000             # for large files, chunk processing

# If your corpus is one-document-per-line, keep True; otherwise False to treat whole file as one doc.
ONE_DOC_PER_LINE = True


# ---------------------------
# Helpers
# ---------------------------
def resolve_input_file(base_dir: Path, basename: str) -> Path:
    """Find the corpus file even if the extension wasn't provided."""
    candidate = base_dir / basename
    if candidate.exists() and candidate.is_file():
        return candidate

    exts = ["", ".txt", ".csv", ".tsv", ".jsonl"]
    for ext in exts:
        p = base_dir / f"{basename}{ext}"
        if p.exists() and p.is_file():
            return p

    raise FileNotFoundError(
        f"Could not find '{basename}' in {base_dir}. "
        f"Tried: {basename}, {basename}.txt, .csv, .tsv, .jsonl"
    )


def basic_clean(text: str) -> str:
    """Lightweight cleaning before spaCy: normalize whitespace + remove odd control chars."""
    text = text.replace("\u00a0", " ")  # non-breaking space
    text = re.sub(r"[\r\t]", " ", text)
    text = re.sub(r"\s+", " ", text).strip()
    return text


def token_filter(tok) -> bool:
    """Decide whether to keep a token."""
    if REMOVE_PUNCT and (tok.is_punct or tok.is_quote):
        return False
    if REMOVE_NUMS and (tok.like_num or tok.is_digit):
        return False
    if tok.is_space:
        return False
    if REMOVE_STOPWORDS and tok.is_stop:
        if KEEP_NEGATIONS and tok.lower_ in {"no", "not", "n't"}:
            return True
        return False

    # drop URLs/emails if spaCy detects them
    if tok.like_url or tok.like_email:
        return False

    # drop very short tokens
    candidate = tok.lemma_ if USE_LEMMA else tok.text
    candidate = candidate.lower() if LOWERCASE else candidate
    if len(candidate) < MIN_TOKEN_LEN:
        return False

    # remove stray non-word tokens
    if re.fullmatch(r"_+", candidate):
        return False

    return True


def normalize_token(tok) -> str:
    """Convert token to output form."""
    out = tok.lemma_ if USE_LEMMA else tok.text
    out = out.lower() if LOWERCASE else out
    return out


def read_docs(path: Path) -> Iterable[str]:
    """Yield documents from file."""
    if ONE_DOC_PER_LINE:
        with path.open("r", encoding="utf-8", errors="ignore") as f:
            for line in f:
                line = basic_clean(line)
                if line:
                    yield line
    else:
        text = path.read_text(encoding="utf-8", errors="ignore")
        text = basic_clean(text)
        if text:
            yield text


def batched(iterable: Iterable[str], n: int) -> Iterable[List[str]]:
    batch = []
    for item in iterable:
        batch.append(item)
        if len(batch) >= n:
            yield batch
            batch = []
    if batch:
        yield batch


# ---------------------------
# Main
# ---------------------------
def main() -> int:
    in_path = resolve_input_file(BASE_DIR, BASENAME)
    OUT_DIR.mkdir(parents=True, exist_ok=True)

    out_txt = OUT_DIR / f"{BASENAME}.preprocessed.txt"
    out_csv = OUT_DIR / f"{BASENAME}.tokens.csv"

    try:
        nlp = spacy.load(SPACY_MODEL, disable=["ner"])  # NER not needed for preprocessing
    except OSError:
        print(
            f"spaCy model '{SPACY_MODEL}' not found.\n"
            f"Install it with:\n"
            f"  python -m spacy download {SPACY_MODEL}\n",
            file=sys.stderr,
        )
        return 1

    # Optional: speed tweaks
    nlp.max_length = 10_000_000  # adjust if your file is extremely large

    doc_count = 0
    token_rows: List[Tuple[int, str]] = []

    with out_txt.open("w", encoding="utf-8") as f_out:
        for batch in batched(read_docs(in_path), BATCH_SIZE):
            # nlp.pipe is much faster than processing line-by-line
            for doc in nlp.pipe(batch, batch_size=64):
                doc_count += 1
                kept = [normalize_token(t) for t in doc if token_filter(t)]
                f_out.write(" ".join(kept) + "\n")

                # If you want a CSV of tokens by doc_id, store them here
                # (comment out if you don't need it for memory reasons)
                for tok in kept:
                    token_rows.append((doc_count, tok))

    # Write tokens CSV (doc_id, token)
    with out_csv.open("w", encoding="utf-8") as f_csv:
        f_csv.write("doc_id,token\n")
        for doc_id, tok in token_rows:
            # minimal CSV escaping
            tok_esc = tok.replace('"', '""')
            f_csv.write(f'{doc_id},"{tok_esc}"\n')

    print("Done ✅")
    print(f"Input:  {in_path}")
    print(f"Output: {out_txt}")
    print(f"Tokens: {out_csv}")
    print(f"Docs processed: {doc_count}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
